{
  "name": "ovenbird-ui",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "api-types": "node scripts/api-types.mjs",
    "api-types:check": "node scripts/api-types.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "22.19.1",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "postcss-custom-media": "12.0.3",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
