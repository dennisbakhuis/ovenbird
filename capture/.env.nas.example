# Recorder against the live broker, run on the NAS for weeks.
# Use a READ-ONLY broker account (ACL: topic read #) — see README.
MQTT_HOST=mqtt.lab.example.net
MQTT_PORT=1883
MQTT_USERNAME=recorder
MQTT_PASSWORD=change-me
TOPICS=panasonic_heat_pump/#,climate_manager_capture/#
CAPTURE_NAME=live
HEARTBEAT_SECONDS=300
TZ=Europe/Amsterdam
